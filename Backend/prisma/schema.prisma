generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountStatus {
  ACTIVE
  PENDING_DELETION
}

enum AccountDeletionTaskStatus {
  PENDING
  PROCESSING
  FAILED
}

enum StorageObjectTaskStatus {
  UPLOADING
  PENDING_CLEANUP
  PROCESSING
}

model User {
  id                  String        @id @default(uuid())
  email               String        @unique
  emailVerifiedAt     DateTime?
  passwordHash        String
  name                String?
  sessionVersion      Int           @default(0)
  accountStatus       AccountStatus @default(ACTIVE)
  deletionRequestedAt DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  refreshTokens          RefreshToken[]
  emailVerificationToken EmailVerificationToken?
  files                  File[]
  folders                Folder[]
  shareLinks             ShareLink[]             @relation("ShareLinkCreator")
  receivedShares         ShareLink[]             @relation("ShareLinkRecipient")
  activities             Activity[]
  accountDeletionTask    AccountDeletionTask?
  storageObjectTasks     StorageObjectTask[]

  @@index([accountStatus])
}

model AccountDeletionTask {
  id            String                    @id @default(uuid())
  userId        String                    @unique
  status        AccountDeletionTaskStatus @default(PENDING)
  attempts      Int                       @default(0)
  nextAttemptAt DateTime                  @default(now())
  leaseUntil    DateTime?
  claimToken    String?                   @unique
  lastFailureCode String?
  lastFailureAt DateTime?
  failedAt      DateTime?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
}

model StorageObjectTask {
  id            String                  @id @default(uuid())
  userId        String
  storageKey    String                  @unique
  status        StorageObjectTaskStatus @default(UPLOADING)
  attempts      Int                     @default(0)
  nextAttemptAt DateTime                @default(now())
  leaseUntil    DateTime?
  claimToken    String?                 @unique
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, nextAttemptAt])
  @@index([status, nextAttemptAt])
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id         String    @id @default(uuid())
  tokenHash  String    @unique
  userId     String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model Folder {
  id        String   @id @default(uuid())
  name      String
  ownerId   String
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner    User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  parent   Folder?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Folder[] @relation("FolderHierarchy")
  files    File[]

  @@index([ownerId])
  @@index([parentId])
  @@index([ownerId, parentId])
}

model File {
  id               String    @id @default(uuid())
  name             String
  originalName     String
  storageKey       String    @unique
  mimeType         String
  size             BigInt
  ownerId          String
  folderId         String?
  processingStatus String?   @default("COMPLETED")
  metadata         Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  owner      User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  folder     Folder?       @relation(fields: [folderId], references: [id], onDelete: SetNull)
  shareLinks ShareLink[]
  versions   FileVersion[]

  @@index([ownerId])
  @@index([folderId])
  @@index([ownerId, folderId])
  @@index([ownerId, name])
  @@index([ownerId, deletedAt])
}

model FileVersion {
  id         String   @id @default(uuid())
  fileId     String
  version    Int
  storageKey String   @unique
  mimeType   String
  size       BigInt
  createdAt  DateTime @default(now())

  file File @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([fileId, version])
  @@index([fileId, createdAt])
}

model ShareLink {
  id              String    @id @default(uuid())
  tokenHash       String    @unique
  fileId          String
  createdById     String
  permission      String    @default("VIEW")
  sharedWithEmail String?
  sharedWithId    String?
  expiresAt       DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  file       File  @relation(fields: [fileId], references: [id], onDelete: Cascade)
  createdBy  User  @relation("ShareLinkCreator", fields: [createdById], references: [id], onDelete: Cascade)
  sharedWith User? @relation("ShareLinkRecipient", fields: [sharedWithId], references: [id], onDelete: SetNull)

  @@index([fileId])
  @@index([createdById])
  @@index([sharedWithId])
  @@index([sharedWithEmail])
  @@index([expiresAt])
}

model Activity {
  id           String   @id @default(uuid())
  userId       String
  action       String
  resourceType String
  resourceId   String?
  resourceName String
  details      Json?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([resourceId])
}
