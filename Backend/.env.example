
# Server
NODE_ENV=development
PORT=8000
# Number of trusted reverse-proxy hops; keep 0 when the API is directly exposed.
TRUST_PROXY_HOPS=0
# Test client rate-limit isolation for automated tests; rejected when NODE_ENV is production.
ALLOW_TEST_CLIENT_ISOLATION=false
AUTH_RATE_LIMIT_MAX=10

# Frontend origin(s), comma-separated if needed
FRONTEND_URL=http://localhost:3000

# Resend email delivery for production. Development/test environments capture
# messages locally when EMAIL_PROVIDER is blank.
EMAIL_PROVIDER=
EMAIL_FROM=CloudVault <no-reply@example.com>
RESEND_API_KEY=
EMAIL_CAPTURE_DIRECTORY=.mail-capture

# PostgreSQL / Neon
DATABASE_URL=

# JWT secrets: generate separate, strong random values
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# S3-compatible object storage
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Redis / BullMQ
REDIS_ENABLED=true
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Integration tests use Backend/.env.integration (see .env.integration.example).
# The runner accepts only the dedicated local PostgreSQL, Redis, and MinIO services.
