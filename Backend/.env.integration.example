# Copy to .env.integration locally. The integration runner loads this file
# without overriding explicitly supplied process environment variables.
INTEGRATION_DATABASE_URL=
INTEGRATION_REDIS_URL=redis://127.0.0.1:56379/15
INTEGRATION_S3_ENDPOINT=http://127.0.0.1:59000
INTEGRATION_S3_REGION=us-east-1
INTEGRATION_S3_BUCKET=cloudvault-integration-test
INTEGRATION_S3_ACCESS_KEY_ID=
INTEGRATION_S3_SECRET_ACCESS_KEY=
INTEGRATION_ALLOW_REMOTE=false

# Local-only signing keys used when integration tests import authentication code.
# Generate separate random values; never reuse production or development keys.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
