# LOCAL/TESTING ONLY. Run setup.sh to generate deploy/docker/.env.
# Never use these placeholder values for a public or production deployment.
APP_DB_NAME=cloudvault_app
APP_DB_USER=cloudvault_app
APP_DB_PASSWORD=generate-a-unique-local-value
REDIS_PASSWORD=generate-a-unique-local-value
MINIO_ROOT_USER=generate-a-unique-local-value
MINIO_ROOT_PASSWORD=generate-a-unique-local-value
APP_S3_ACCESS_KEY_ID=generate-a-unique-local-value
APP_S3_SECRET_ACCESS_KEY=generate-a-unique-local-value
JWT_ACCESS_SECRET=generate-a-unique-local-value-at-least-32-characters
JWT_REFRESH_SECRET=generate-a-different-local-value-at-least-32-characters
FRONTEND_HOST_PORT=38080
MINIO_CONSOLE_HOST_PORT=39001
APP_HOST_UID=1000
APP_HOST_GID=1000
# Optional. Store an HMAC key in a separate protected file, never inside backups.
BACKUP_HMAC_KEY_FILE=
RESTORE_EXCLUDED_OBJECT_PREFIXES=
