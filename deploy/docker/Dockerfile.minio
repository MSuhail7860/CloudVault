ARG MINIO_BASE_IMAGE=cgr.dev/chainguard/minio@sha256:869ca3178831d9f521ea02258a0f0d4fbc1e9f84302e707514e1f861b860865d
FROM busybox:1.37.0-musl@sha256:f6a95d611e0a8780fabdb2aec43e31275b2720dfefa3e41b16835bfc42454478 AS healthcheck

FROM ${MINIO_BASE_IMAGE}
COPY --from=healthcheck /bin/busybox /usr/bin/busybox
EXPOSE 9000 9001
HEALTHCHECK --interval=10s --timeout=3s --start-period=20s --retries=10 \
  CMD ["/usr/bin/busybox", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:9000/minio/health/ready"]
