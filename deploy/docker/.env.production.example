# EXAMPLE ONLY. Copy to an approved secret-injection system or an ignored
# deploy/docker/.env.production file with mode 0600; never commit real values.
NODE_ENV=production
ALLOW_TEST_CLIENT_ISOLATION=false
TRUST_PROXY_HOPS=2
FRONTEND_URL=https://cloudvault.example.invalid
FRONTEND_HOST_PORT=38081
EMAIL_PROVIDER=resend
EMAIL_FROM=CloudVault <no-reply@example.invalid>
RESEND_API_KEY=replace-with-secret-from-secret-manager
DATABASE_URL=postgresql://user:replace-me@postgres.example.invalid:5432/cloudvault?sslmode=verify-full
DATABASE_URL_UNPOOLED=postgresql://user:replace-me@postgres-unpooled.example.invalid:5432/cloudvault?sslmode=verify-full
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=use-a-different-32-character-random-secret
REDIS_ENABLED=true
REDIS_URL=rediss://user:replace-me@redis.example.invalid:6380/0
S3_ENDPOINT=https://s3.example.invalid
S3_REGION=replace-with-region
S3_BUCKET=replace-with-production-bucket
S3_ACCESS_KEY_ID=replace-with-least-privilege-access-key
S3_SECRET_ACCESS_KEY=replace-with-least-privilege-secret
